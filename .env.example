# ==================================================
# HH Goa 2026 — Voice-Enabled RAG Environment Config
# ==================================================

# Speech-To-Text (STT) Settings
# Provider options: 'sarvam' (Sarvam AI), 'elevenlabs' (ElevenLabs), 'whisper' (OpenAI), 'auto'
STT_PROVIDER=sarvam
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Large Language Model (LLM) Settings
# Provider options: 'openai', 'groq', 'gemini', 'fallback'
LLM_PROVIDER=openai
LLM_API_KEY=
MODEL_NAME=gpt-4o-mini

# Vector Store & Retrieval Settings
VECTOR_STORE_PATH=backend/data/vector_store.pkl
BENCHMARK_RESULTS_PATH=backend/data/benchmark_results.json
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K=4
SIMILARITY_THRESHOLD=0.30
MAX_CONTEXT_LENGTH=2000
